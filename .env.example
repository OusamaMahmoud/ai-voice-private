# Server Configuration
PORT=3000
NODE_ENV=production

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./config/vertex-credentials.json
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_LIVE_MODEL=gemini-2.5-flash-native-audio

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+13348888892

# Application Settings
AI_VOICE_LANGUAGE=en-US
CALL_TIMEOUT_MS=600000
LOG_DIRECTORY=./logs/transcripts